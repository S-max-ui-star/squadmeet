# Caddy in the production image. DOMAIN comes from the environment (deploy/compose.yml).
# With a real domain, Caddy gets a Let's Encrypt certificate and redirects HTTP to HTTPS.
{$DOMAIN:localhost} {
	# Security headers on every answer (SCRUM-49 review): HTTPS only for a year, no framing of
	# the app by other sites (clickjacking), no MIME guessing, no full URL to other sites, and
	# no Caddy version.
	# The CSP allows only our own files plus: the Turnstile captcha (script and iframe from
	# Cloudflare), the OSM map tiles, Photos from presigned S3 links, and inline styles (Leaflet
	# and Turnstile set them). API calls and the live stream go to our own origin only.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.amazonaws.com; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Not the live stream (SCRUM-93): compression would hold its events back.
	@compress not path /api/live
	encode @compress zstd gzip

	# Each live event goes to the page at once.
	handle /api/live {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# The React app: unknown paths get index.html, so a reload on a client route works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
