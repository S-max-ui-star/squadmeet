# Caddy in the production image. DOMAIN comes from the environment (deploy/compose.yml).
# With a real domain, Caddy gets a Let's Encrypt certificate and redirects HTTP to HTTPS.
{$DOMAIN:localhost} {
	# Not the live stream (SCRUM-93): compression would hold its events back.
	@compress not path /api/live
	encode @compress zstd gzip

	# Each live event goes to the page at once.
	handle /api/live {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Built files with a hash in the name never change: cache them for a year. A missing one is a
	# 404, not index.html: an HTML answer to a script request would leave a white page (SCRUM-109).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The React app: unknown paths get index.html, so a reload on a client route works.
	# no-cache: the browser asks again each time (cheap with the ETag), so after a deploy it never
	# keeps an old index.html that names assets of the old build (SCRUM-109).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
